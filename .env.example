# GEMINI_API_KEY: Required for Gemini AI vision and enhancement operations.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# REPLICATE_API_TOKEN: Optional API token for dedicated Real-ESRGAN / CodeFormer upscaling models.
# If provided, high-throughput dedicated neural super-resolution endpoints can be leveraged.
REPLICATE_API_TOKEN=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
